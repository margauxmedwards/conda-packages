diff --git a/Thirdparty/DBoW2/CMakeLists.txt b/Thirdparty/DBoW2/CMakeLists.txt
index 73618ad..f0ef001 100644
--- a/Thirdparty/DBoW2/CMakeLists.txt
+++ b/Thirdparty/DBoW2/CMakeLists.txt
@@ -35,8 +35,13 @@ set(SRCS_DUTILS
   DUtils/Random.cpp
   DUtils/Timestamp.cpp)
 
-# Create shared library
-add_library(${PROJECT_NAME} SHARED ${SRCS_DBOW2} ${SRCS_DUTILS} )
+set(DBOW2_LIB_TYPE SHARED)
+if(WIN32)
+  set(DBOW2_LIB_TYPE STATIC)
+endif()
+
+# Build static on Windows to avoid missing dll-exported data symbols
+add_library(${PROJECT_NAME} ${DBOW2_LIB_TYPE} ${SRCS_DBOW2} ${SRCS_DUTILS})
 
 # Apply warnings and optimization flags
 target_link_libraries(${PROJECT_NAME} PRIVATE dbow2_warnings)
