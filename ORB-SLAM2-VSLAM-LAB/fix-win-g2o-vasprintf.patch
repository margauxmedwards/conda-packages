@@ -45,6 +45,34 @@ namespace g2o {
 
 using namespace std;
 
+static int g2oVasprintf(char** strp, const char* fmt, va_list ap)
+{
+#if defined(_MSC_VER)
+  va_list ap_len;
+  va_copy(ap_len, ap);
+  const int len = _vscprintf(fmt, ap_len);
+  va_end(ap_len);
+  if (len < 0)
+    return -1;
+
+  *strp = static_cast<char*>(malloc(static_cast<size_t>(len) + 1));
+  if (*strp == NULL)
+    return -1;
+
+  va_list ap_write;
+  va_copy(ap_write, ap);
+  const int written = vsnprintf(*strp, static_cast<size_t>(len) + 1, fmt, ap_write);
+  va_end(ap_write);
+  if (written < 0) {
+    free(*strp);
+    *strp = NULL;
+  }
+  return written;
+#else
+  return vasprintf(strp, fmt, ap);
+#endif
+}
